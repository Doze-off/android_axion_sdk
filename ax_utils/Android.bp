package {
    default_visibility: ["//visibility:public"],
}

android_library {
    name: "ax_utils",
    manifest: "AndroidManifest.xml",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    resource_dirs: ["res"],

    static_libs: [
        "kotlin-stdlib",
    ],

    sdk_version: "current",
    min_sdk_version: "current",

    kotlincflags: [
        "-Xjvm-default=all",
    ],

    use_resource_processor: true,
}
