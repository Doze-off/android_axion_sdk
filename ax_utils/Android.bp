package {
    default_visibility: ["//visibility:public"],
}

android_library {
    name: "ax_utils",
    manifest: "AndroidManifest.xml",

    srcs: [
        "src/**/*.java",
    ],

    resource_dirs: ["res"],

    sdk_version: "current",
    min_sdk_version: "current",

    use_resource_processor: true,
}
