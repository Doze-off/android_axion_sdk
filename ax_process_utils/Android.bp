package {
    default_visibility: ["//visibility:public"],
}

cc_library_static {
    name: "ax_process_utils",

    srcs: ["src/**/*.cpp"],

    export_include_dirs: ["include"],

    shared_libs: ["liblog", "libbase"],

    cflags: ["-Wall", "-Werror", "-fvisibility=hidden"],

    host_supported: false,
    visibility: ["//visibility:public"],
}
